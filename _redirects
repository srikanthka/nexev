# ═══ NexEV — Cloudflare Pages _redirects ═══
# Docs: https://developers.cloudflare.com/pages/configuration/redirects/

# ── 301 Permanent redirects (fixes "Page with redirect" in GSC) ──────
# Replace HTML meta-refresh redirects with proper HTTP 301s

/pages/training-redirect      /pages/coming-soon.html   301
/pages/training-redirect.html /pages/coming-soon.html   301
/pages/training               /pages/coming-soon.html   301
/pages/training.html          /pages/coming-soon.html   301
/training                     /pages/coming-soon.html   301

# ── Product URLs ──────────────────────────────────────────────────────
# Rule order matters — Cloudflare Pages applies the first match.

# 1. If someone accesses /products/name.html — redirect to clean URL
#    (prevents _redirects from adding double .html when file isn't found)
/products/:slug.html  /products/:slug         301

# 2. Clean URL /products/name → serve the actual .html file (200 rewrite, no redirect)
/products/:slug       /products/:slug.html    200
